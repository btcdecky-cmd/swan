# Helius (required for on-chain task claims)
HELIUS_API_KEY=
VITE_HELIUS_API_KEY=
HELIUS_NETWORK=devnet

# Solana RPC (defaults to Helius or public devnet)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Protocol mode: sim | rpc
SWAN_PROTOCOL_MODE=sim
VITE_SWAN_PROTOCOL_MODE=sim

# After: npm run deploy:escrow
SWAN_PROGRAM_ID=
VITE_SWAN_PROGRAM_ID=

# Bags / Supabase optional
BAGS_API_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
